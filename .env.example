# Optional: enables live diagnosis through Hugging Face Inference Providers router.
# Token must have "Make calls to Inference Providers" permission.
HF_API_TOKEN=
HF_MODEL=meta-llama/Llama-3.2-3B-Instruct

# auto tries Hugging Face first, then local Ollama, then rules fallback.
# Values: auto | huggingface | ollama | fallback
AI_BACKEND=auto

# Local Ollama (used automatically when running: ollama serve)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest

ALLOWED_ORIGINS=http://localhost:8000
